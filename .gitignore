# 保留入口目录，占位文件之外的本地创作资料不提交
/收件箱/*
!/收件箱/.gitkeep
/内容项目/*
!/内容项目/.gitkeep
/灵感选题/*
!/灵感选题/.gitkeep
/历史归档/*
!/历史归档/.gitkeep

